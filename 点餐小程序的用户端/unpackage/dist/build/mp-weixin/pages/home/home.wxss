.wrap{min-height:100vh;padding:0 30rpx 32rpx;background:#f5fcfc;color:#65483d;overflow:hidden}.wrap__brand{height:44px;padding-right:190rpx;display:flex;align-items:center;font-size:23rpx;font-weight:600;letter-spacing:1rpx}.wrap__brand__mark{width:42rpx;height:42rpx;line-height:42rpx;margin-right:12rpx;border-radius:15rpx;background:#f9dfda;text-align:center;font-size:30rpx}.wrap__greeting{padding:16rpx 8rpx 28rpx}.wrap__greeting__title{font-size:42rpx;font-weight:700;letter-spacing:2rpx}.wrap__greeting__title text{color:#cf827b;margin-left:8rpx}.wrap__greeting__subtitle{font-size:24rpx;color:#947d70;margin-top:10rpx}.wrap__hero{position:relative;padding:10rpx;border:2rpx solid #eaded2;border-radius:38rpx;background:#fffdf7;box-shadow:0 8rpx 0 #e8f0ed;overflow:hidden}.wrap__hero__label{position:absolute;left:30rpx;top:30rpx;padding:10rpx 20rpx;background:rgba(255,253,247,.94);border:2rpx solid #eaded2;border-radius:30rpx;font-size:22rpx;color:#815b49;pointer-events:none}.wrap__userinfo{display:flex;align-items:center;justify-content:space-between;margin-top:26rpx;padding:20rpx 24rpx;background:#fffdf7;border:2rpx solid #eee5d9;border-radius:28rpx}.wrap__userinfo__avatar{flex-shrink:0;border:4rpx solid #fff;border-radius:50%;overflow:hidden}.wrap__userinfo__left{display:flex;align-items:center;min-width:0;flex:1}.wrap__userinfo__left__nickname{min-width:0;margin-left:16rpx;font-size:26rpx;font-weight:600}.wrap__userinfo__left__nickname view{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.wrap__userinfo__left__nickname text{display:block;font-size:21rpx;font-weight:400;color:#947d70;margin-top:6rpx}.wrap__userinfo__right{flex-shrink:0;margin-left:12rpx;background:#815b49;color:#fffdf7;padding:14rpx 22rpx;border-radius:28rpx;font-size:23rpx}.wrap__userinfo__heart{color:#d58c82;font-size:46rpx;margin-left:20rpx}.wrap__tablecard{position:relative;margin-top:24rpx;padding:24rpx 30rpx;border-radius:28rpx;background:#e6f3f4;border:2rpx dashed #a7cacf}.wrap__tablecard__label{font-size:24rpx}.wrap__tablecard__value{font-size:44rpx;font-weight:700;margin:8rpx 0}.wrap__tablecard__desc{font-size:23rpx;color:#78675e}.wrap__section{display:flex;justify-content:space-between;align-items:center;padding:30rpx 6rpx 18rpx;font-size:29rpx;font-weight:600}.wrap__section text:last-child{font-size:18rpx;color:#947d70;letter-spacing:3rpx;font-weight:400}.wrap__menu{display:flex;gap:20rpx}.wrap__menu__box{position:relative;flex:1;min-width:0;padding:30rpx 24rpx 24rpx;border-radius:32rpx;border:2rpx solid #d8e9e7;box-shadow:0 7rpx 0 #e2efed;transition:-webkit-transform .15s;transition:transform .15s;transition:transform .15s,-webkit-transform .15s}.wrap__menu__box--dine{background:#eaf8fa}.wrap__menu__box--delivery{background:#fceee7;border-color:#efdcd1;box-shadow:0 7rpx 0 #f0e5de}.wrap__menu__box--pressed{-webkit-transform:translateY(4rpx);transform:translateY(4rpx)}.wrap__menu__box__art{position:absolute;right:18rpx;top:18rpx;border:5rpx solid #fffdf7;border-radius:50%;-webkit-transform:rotate(7deg);transform:rotate(7deg)}.wrap__menu__box--delivery .wrap__menu__box__art{-webkit-transform:rotate(-7deg);transform:rotate(-7deg)}.wrap__menu__box__name{position:relative;font-size:34rpx;font-weight:700;margin-top:92rpx}.wrap__menu__box__desc{font-size:23rpx;margin-top:8rpx;color:#887064}.wrap__menu__box__action{display:flex;justify-content:space-between;align-items:center;margin-top:24rpx;padding-top:16rpx;border-top:2rpx dashed rgba(101,72,61,.18);font-size:23rpx}.wrap__menu__box__action text{font-size:32rpx;line-height:30rpx}.wrap__bottom-background{display:flex;flex-direction:column;align-items:center;margin-top:32rpx;padding:26rpx 20rpx 16rpx;background:#b2f1fa;border-radius:36rpx;overflow:hidden;pointer-events:none}.wrap__bottom-background__note{font-size:24rpx;color:#65483d;letter-spacing:2rpx;margin-bottom:18rpx}.wrap__popup{position:fixed;left:0;top:0;width:100%;height:100%;z-index:99}.wrap__popup__mask{position:absolute;inset:0;background:rgba(66,49,39,.4)}.wrap__popup__panel{position:absolute;left:50%;top:50%;-webkit-transform:translate(-50%,-50%);transform:translate(-50%,-50%);width:86%;background:#fffdf7;border:4rpx solid #eaded2;border-radius:40rpx;padding:32rpx}.wrap__popup__art{display:flex;justify-content:center;margin-bottom:24rpx}.wrap__popup__title{text-align:center;font-size:38rpx;font-weight:700}.wrap__popup__table{margin-top:16rpx;text-align:center;font-size:40rpx;font-weight:700}.wrap__popup__subtitle{margin-top:12rpx;text-align:center;font-size:24rpx;color:#947d70}.wrap__popup__options{display:grid;grid-template-columns:repeat(4,1fr);gap:16rpx;margin-top:30rpx}.wrap__popup__option{height:80rpx;border-radius:22rpx;background:#f3eee5;font-size:28rpx;display:flex;align-items:center;justify-content:center;border:2rpx solid transparent}.wrap__popup__option--active{background:#eaf8fa;border-color:#9dbec1;font-weight:700}.wrap__popup__actions{display:flex;gap:16rpx;margin-top:32rpx}.wrap__popup__button{flex:1;height:88rpx;border-radius:44rpx;background:#815b49;color:#fffdf7;font-size:28rpx;display:flex;align-items:center;justify-content:center}.wrap__popup__button--ghost{background:#f3eee5;color:#65483d}