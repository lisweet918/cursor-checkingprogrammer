<view class="wrap"><view class="wrap__safe" style="{{'height:'+(statusBarHeight+'px')+';'}}"></view><view class="wrap__brand"><view class="wrap__brand__mark">♡</view><text>一二布布 · 饭饭日常</text></view><view class="wrap__greeting"><view class="wrap__greeting__title">一起好好吃饭呀 <text>♡</text></view><view class="wrap__greeting__subtitle">把小日子，过得软乎乎的</view></view><view class="wrap__hero"><u-swiper vue-id="1da55560-1" list="{{swiperList}}" height="470" border-radius="28" mode="none" bind:__l="__l"></u-swiper><view class="wrap__hero__label">今日份可爱已送达</view></view><view data-event-opts="{{[['tap',[['handleLogin',['$event']]]]]}}" class="wrap__userinfo" bindtap="__e"><view class="wrap__userinfo__left"><view class="wrap__userinfo__avatar"><block wx:if="{{userinfo.avatar}}"><u-image vue-id="1da55560-2" src="{{displayAvatar}}" width="68" height="68" border-radius="50%" lazy-load="{{true}}" bind:__l="__l"></u-image></block><block wx:else><yier-art vue-id="1da55560-3" character="yier" size="{{68}}" bind:__l="__l"></yier-art></block></view><view class="wrap__userinfo__left__nickname"><view>{{userinfo.nickname||'你好呀，饭饭搭子'}}</view><text>今天的快乐，从吃饱开始</text></view></view><block wx:if="{{!userinfo.nickname}}"><view class="wrap__userinfo__right"><view>去登录 ›</view></view></block><block wx:else><text class="wrap__userinfo__heart">♡</text></block></view><block wx:if="{{tableInfo.tableNumber}}"><view class="wrap__tablecard"><view class="wrap__tablecard__label">当前桌号</view><view class="wrap__tablecard__value">{{tableInfo.tableNumber}}</view><view class="wrap__tablecard__desc">{{''+(tableInfo.diningCount?tableInfo.diningCount+'人就餐':'请选择就餐人数后开始点餐')+''}}</view></view></block><view class="wrap__section"><text>今天想怎么吃？</text><text>HAPPY MEAL</text></view><view class="wrap__menu"><view class="wrap__menu__box wrap__menu__box--dine" hover-class="wrap__menu__box--pressed" data-event-opts="{{[['tap',[['handlePointSingle',['takein']]]]]}}" bindtap="__e"><view class="wrap__menu__box__art"><yier-art vue-id="1da55560-4" character="yier" size="{{104}}" bind:__l="__l"></yier-art></view><view class="wrap__menu__box__name">门店堂食</view><view class="wrap__menu__box__desc">一二陪你，慢慢吃</view><view class="wrap__menu__box__action">到店吃饭 <text>↗</text></view></view><view class="wrap__menu__box wrap__menu__box--delivery" hover-class="wrap__menu__box--pressed" data-event-opts="{{[['tap',[['handlePointSingle',['takeout']]]]]}}" bindtap="__e"><view class="wrap__menu__box__art"><yier-art vue-id="1da55560-5" character="bubu" size="{{104}}" bind:__l="__l"></yier-art></view><view class="wrap__menu__box__name">外卖配送</view><view class="wrap__menu__box__desc">布布陪你，宅家吃</view><view class="wrap__menu__box__action">送到身边 <text>↗</text></view></view></view><view class="wrap__bottom-background"><view class="wrap__bottom-background__note">♡ 和你一起，吃什么都开心 ♡</view><yier-art vue-id="1da55560-6" character="pair" size="{{630}}" bind:__l="__l"></yier-art></view><block wx:if="{{tablePopupVisible}}"><view class="wrap__popup"><view data-event-opts="{{[['tap',[['closeTablePopup',['$event']]]]]}}" class="wrap__popup__mask" bindtap="__e"></view><view class="wrap__popup__panel"><view class="wrap__popup__art"><yier-art vue-id="1da55560-7" character="pair" size="{{210}}" bind:__l="__l"></yier-art></view><view class="wrap__popup__title">欢迎入座</view><view class="wrap__popup__table">{{"当前桌号 "+currentTableNumber}}</view><view class="wrap__popup__subtitle">请选择本桌就餐人数</view><view class="wrap__popup__options"><block wx:for="{{diningCountOptions}}" wx:for-item="item" wx:for-index="__i0__" wx:key="*this"><view data-event-opts="{{[['tap',[['selectDiningCount',['$0'],[[['diningCountOptions','',__i0__]]]]]]]}}" class="{{['wrap__popup__option',(selectedDiningCount===item)?'wrap__popup__option--active':'']}}" bindtap="__e">{{''+item+'人'}}</view></block></view><view class="wrap__popup__actions"><view data-event-opts="{{[['tap',[['closeTablePopup',['$event']]]]]}}" class="wrap__popup__button wrap__popup__button--ghost" bindtap="__e">稍后选择</view><view data-event-opts="{{[['tap',[['confirmTableInfo',['$event']]]]]}}" class="wrap__popup__button" bindtap="__e">开始点餐</view></view></view></view></block></view>