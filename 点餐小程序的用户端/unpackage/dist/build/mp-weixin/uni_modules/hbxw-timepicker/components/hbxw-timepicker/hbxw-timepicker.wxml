<block wx:if="{{isShow}}"><view class="{{['hbxw-timepicker','data-v-483267bf',(isAni)?'hbxw-timepicker-ani':'']}}" style="{{'z-index:'+(zIndex)+';'+('--opacity:'+(maskOpacity)+';')}}"><view data-event-opts="{{[['tap',[['close',['$event']]]]]}}" class="hbxw-timepicker-mask data-v-483267bf" bindtap="__e"></view><view class="{{['hbxw-timepicker-main','data-v-483267bf',(isAni)?'hbxw-timepicker-main-ani':'']}}"><view class="hbxw-timepicker-title data-v-483267bf"><block wx:if="{{$slots.title}}"><slot name="title"></slot><scoped-slots-title title="{{title}}" subTitle="{{subTitle}}" class="scoped-ref" bind:__l="__l"></scoped-slots-title></block><block wx:else><view class="hbxw-timepicker-title-main data-v-483267bf">{{title}}</view><view class="hbxw-timepicker-title-subtitle data-v-483267bf">{{subTitle}}</view></block><image class="hbxw-timepicker-close data-v-483267bf" src="{{closeImgSrc}}" data-event-opts="{{[['tap',[['close',['$event']]]]]}}" bindtap="__e"></image></view><view class="hbxw-timepicker-content data-v-483267bf"><view class="hbxw-timepicker-day data-v-483267bf"><block wx:for="{{days}}" wx:for-item="day" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['toggleDay',[index]]]]]}}" class="{{['hbxw-timepicker-day-item','data-v-483267bf',(dayActiveIndex===index)?'hbxw-timepicker-day-item-active':'']}}" bindtap="__e">{{''+day.displayText+''}}</view></block></view><view class="hbxw-timepicker-time data-v-483267bf"><block wx:for="{{$root.l0}}" wx:for-item="hour" wx:for-index="index" wx:key="index"><block wx:if="{{hour.g0>0}}"><view data-event-opts="{{[['tap',[['toggleHour',[index]]]]]}}" class="{{['hbxw-timepicker-time-item','data-v-483267bf',(hourActiveIndex===index)?'hbxw-timepicker-time-item-active':'']}}" bindtap="__e"><text class="hbxw-timepicker-time-val data-v-483267bf">{{hour.$orig.hoursStr}}</text><view class="hbxw-timepicker-time-icon data-v-483267bf"><image class="hbxw-timepicker-time-img data-v-483267bf" src="{{selectImgSrc}}"></image></view></view></block><block wx:else><view class="hbxw-timepicker-notime data-v-483267bf"><text class="hbxw-timerpicker-nodata data-v-483267bf">{{noDateTips}}</text></view></block></block></view></view><block wx:if="{{isBtn}}"><block wx:if="{{$slots.btn}}"><slot name="btn"></slot><scoped-slots-btn result="{{result}}" class="scoped-ref" bind:__l="__l"></scoped-slots-btn></block><block wx:else><view class="hbxw-timerpicker-btn-wrap data-v-483267bf"><block wx:if="{{btnStr}}"><view data-event-opts="{{[['tap',[['sure',['$event']]]]]}}" class="hbxw-timerpicker-sure data-v-483267bf" bindtap="__e">{{btnStr}}</view></block></view></block></block></view></view></block>