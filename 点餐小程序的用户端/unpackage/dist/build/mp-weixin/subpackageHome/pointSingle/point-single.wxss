.container{background-color:#fff;display:flex;flex-direction:column}.header{z-index:10}.header .center{padding:10rpx 40rpx;display:flex;flex-direction:column}.header .center .store{display:flex;align-items:center;justify-content:space-between}.header .center .store .title{flex:1;display:flex;overflow:hidden;flex-direction:column}.header .center .store .title .address{font-size:32rpx;color:#343434;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.header .center .store .title .business{font-size:24rpx;color:#909399}.header .center .store .buttons{display:flex;align-items:stretch;background-color:#f6f6f6;border-radius:50rem!important;padding:4rpx;border:2rpx solid #eaeaea}.header .center .store .buttons .button{height:100%;width:50%;border-radius:50rem!important;border:0!important;font-size:24rpx!important;line-height:2.4!important}.header .center .store .buttons .button.active{background-color:#0a3d28;color:#fff!important;transition:all .3s}.main{flex:1;display:flex;overflow:hidden}.menu-bar{width:170rpx;background-color:#f6f6f6}.menu-bar .wrapper{height:auto}.menu-bar .wrapper .menu-item{padding:30rpx 20rpx;display:flex;flex-direction:column;align-items:center;font-size:26rpx;color:#999;overflow:hidden}.menu-bar .wrapper .menu-item:nth-last-child(1){margin-bottom:100rpx}.menu-bar .wrapper .menu-item .image{width:50rpx;height:50rpx}.menu-bar .wrapper .menu-item .title{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.menu-bar .wrapper .menu-item.active{background-color:#fff;color:#343434;font-weight:500!important;border-left:7rpx solid #0a3d28}.product-section{flex:1}.product-section .wrapper{padding:0 20rpx;padding-bottom:130rpx}.product-section .products-list .category-name{padding:30rpx 0;font-size:26rpx;color:#999}.product-section .products-list .products{display:flex;flex-direction:column;margin-bottom:20rpx}.product-section .products-list .product{display:flex;align-items:flex-start;margin-bottom:40rpx;justify-content:space-between}.product-section .products-list .product .image{width:180rpx;height:135rpx;flex-shrink:0;margin-right:20rpx;border-radius:8rpx}.product-section .products-list .product .content{flex:1;display:flex;flex-direction:column;overflow:hidden}.product-section .products-list .product .content .name{font-size:28rpx;overflow:hidden;text-overflow:ellipsis;margin-bottom:8rpx;font-weight:700;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2}.product-section .products-list .product .content .sold{color:#909399;font-size:20rpx;margin-bottom:9rpx}.product-section .products-list .product .content .labels{display:flex;font-size:20rpx;overflow:hidden;flex-wrap:wrap}.product-section .products-list .product .content .labels .label{max-width:40%;padding:6rpx 10rpx;margin-right:10rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.product-section .products-list .product .content .price{display:flex;align-items:baseline;justify-content:space-between;margin-top:20rpx}.product-section .products-list .product .content .price .prices{display:flex;align-items:baseline;color:#ff362d;font-weight:700}.product-section .products-list .product .content .price .prices text:nth-child(1){font-size:20rpx;margin-right:5rpx}.product-section .products-list .product .content .price .prices text:nth-child(2){font-size:30rpx}.cart-actions{display:flex;align-items:center}.cart-actions .add-btn,
.cart-actions .minus-btn{width:50rpx;height:50rpx}.cart-actions .number{width:50rpx;height:50rpx;margin:0 20rpx;display:flex;justify-content:center;align-items:center;font-size:36rpx}