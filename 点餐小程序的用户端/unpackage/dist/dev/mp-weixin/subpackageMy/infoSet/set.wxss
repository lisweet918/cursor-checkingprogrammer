.wrap__box {
  background-color: white;
  margin: 170rpx 20rpx 0 20rpx;
  border-radius: 18rpx;
  padding: 0 20rpx;
}
.wrap__box__top {
  display: flex;
  justify-content: center;
}
.wrap__box__top__span {
  position: relative;
  border: 20rpx solid #FAFAFA;
  border-radius: 50%;
  margin-top: -100rpx;
}
.wrap__box__top__span button {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
}
.wrap__save {
  background-color: #0A3D28;
  color: white;
  text-align: center;
  padding: 20rpx 0;
  position: fixed;
  bottom: 50rpx;
  left: 0;
  right: 0;
  width: 90%;
  border-radius: 8rpx;
  margin: 0 auto;
}
.wrap__popup__title {
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  color: #131313;
  margin-top: 30rpx;
  letter-spacing: 5rpx;
}
.wrap__popup__input {
  margin: 100rpx 100rpx 20rpx 100rpx;
  border-bottom: 1px solid #F5F5F5;
}
.wrap__popup__tips {
  color: #909399;
  font-size: 24rpx;
  margin: 0 100rpx;
}
.wrap__popup__btn {
  position: fixed;
  bottom: 50rpx;
  left: 0;
  right: 0;
  width: 50%;
  margin: 0 auto;
  background-color: #0A3D28;
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  letter-spacing: 5rpx;
  padding: 30rpx 0;
  border-radius: 18rpx;
  text-align: center;
}
.history-orders {
  margin-top: 20rpx;
  background-color: #fff;
  padding: 20rpx;
  border-radius: 16rpx;
}
.history-orders__title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
  border-left: 8rpx solid #19be6b;
  padding-left: 16rpx;
}
.history-orders__empty {
  text-align: center;
  color: #999;
  padding: 40rpx 0;
}
.history-orders .order-card {
  padding: 20rpx 0;
  border-bottom: 1px solid #f5f5f5;
}
.history-orders .order-card:last-child {
  border-bottom: none;
}
.history-orders .order-card__header {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}
.history-orders .order-card__status {
  color: #19be6b;
}
.history-orders .order-card__content {
  display: flex;
  flex-direction: column;
}
.history-orders .order-card__info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}
.history-orders .order-card__type {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  background-color: #f3f4f6;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.history-orders .order-card__price {
  font-size: 32rpx;
  color: #ff3b3b;
  font-weight: bold;
}
.history-orders .order-card__items {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  font-size: 24rpx;
  color: #666;
}
.history-orders .order-card .order-item {
  background-color: #f8f8f8;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
}
