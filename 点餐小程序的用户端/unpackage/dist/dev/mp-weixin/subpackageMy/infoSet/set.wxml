<view class="wrap"><view class="wrap__box"><view class="wrap__box__top"><button class="avatar-button" style="padding:0;background:none;line-height:0;border:none;overflow:visible;" open-type="chooseAvatar" data-event-opts="{{[['chooseavatar',[['onChooseAvatar',['$event']]]]]}}" bindchooseavatar="__e"><view class="wrap__box__top__span" style="display:block;"><u-avatar vue-id="750fe9e4-1" src="{{displayAvatar}}" size="140" bind:__l="__l"></u-avatar><view class="edit-badge" style="position:absolute;bottom:0;right:0;background:#0A3D28;color:#fff;padding:4rpx 10rpx;border-radius:20rpx;font-size:20rpx;">修改</view></view></button></view><u-cell-group vue-id="750fe9e4-2" border="{{false}}" bg-color="#fff" bind:__l="__l" vue-slots="{{['default']}}"><u-cell-item vue-id="{{('750fe9e4-3')+','+('750fe9e4-2')}}" title="昵称" bg-color="#fff" value="{{userInfo.nickname||'未登录'}}" arrow="{{false}}" bind:__l="__l"></u-cell-item><u-cell-item vue-id="{{('750fe9e4-4')+','+('750fe9e4-2')}}" title="会员积分" bg-color="#fff" value="{{userInfo.points||0}}" arrow="{{false}}" bind:__l="__l"></u-cell-item><u-cell-item vue-id="{{('750fe9e4-5')+','+('750fe9e4-2')}}" title="授权时间" bg-color="#fff" arrow="{{false}}" value="{{$root.m0}}" bind:__l="__l"></u-cell-item></u-cell-group></view><view class="history-orders"><view class="history-orders__title">历史订单</view><block wx:if="{{$root.g0===0}}"><view class="history-orders__empty">暂无历史订单</view></block><block wx:else><view class="history-orders__list"><block wx:for="{{$root.l0}}" wx:for-item="order" wx:for-index="__i0__" wx:key="_id"><view class="order-card"><view class="order-card__header"><text class="order-card__time">{{order.m1}}</text><text class="order-card__status">{{order.m2}}</text></view><view class="order-card__content"><view class="order-card__info"><text class="order-card__type">{{order.$orig.type==='takein'?'堂食':'外卖'}}</text><text class="order-card__price">{{"¥"+order.$orig.price}}</text></view><view class="order-card__items"><block wx:for="{{order.$orig.commodity_list||[]}}" wx:for-item="item" wx:for-index="idx" wx:key="idx"><text class="order-item">{{''+item.name+" x"+item.number+''}}</text></block></view></view></view></block></view></block></view></view>