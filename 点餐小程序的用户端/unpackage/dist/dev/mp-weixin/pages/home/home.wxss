}
.wrap__popup__options {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-top: 28rpx;
}
.wrap__popup__option {
  height: 80rpx;
  border-radius: 24rpx;
  background: #F4EDE2;
  color: #6E4E40;
  font-size: 27rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
