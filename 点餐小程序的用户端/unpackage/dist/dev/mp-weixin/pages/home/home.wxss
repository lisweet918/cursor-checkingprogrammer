}
.wrap__menu__card--takeout {
  background: linear-gradient(165deg, #FFFDF8 0%, #FFF0EC 100%);
  border: 2rpx solid rgba(255, 175, 160, 0.4);
}
.wrap__menu__card--pressed {
  -webkit-transform: scale(0.96);
          transform: scale(0.96);
}
.wrap__menu__card__head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.wrap__menu__card__pill {
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx 16rpx;
  border-radius: 18rpx;
  background: #FFE8C2;
