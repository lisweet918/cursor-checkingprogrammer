.wrap {
  min-height: 100vh;
  padding: 0 30rpx 40rpx;
  background: #FCF9F2;
  color: #5A3F33;
  box-sizing: border-box;
}
.wrap__topbar {
  height: 44px;
  padding-right: 190rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.wrap__topbar__brand {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.wrap__topbar__brand__badge {
  padding: 4rpx 14rpx;
  border-radius: 14rpx;
  background: #FFF0D4;
  color: #9C661D;
  font-size: 20rpx;
  font-weight: 700;
}
.wrap__topbar__brand__name {
  font-size: 27rpx;
  font-weight: 700;
  color: #6E4733;
  letter-spacing: 1rpx;
}
.wrap__topbar__status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 21rpx;
  color: #638558;
  font-weight: 600;
}
.wrap__topbar__status__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #73A766;
  box-shadow: 0 0 8rpx rgba(115, 167, 102, 0.6);
}
.wrap__hero {
  position: relative;
  margin-top: 10rpx;
  padding: 10rpx;
  background: #FFFFFF;
  border-radius: 40rpx;
  box-shadow: 0 14rpx 36rpx rgba(125, 83, 60, 0.08);
}
.wrap__hero__swiper {
  border-radius: 36rpx;
  overflow: hidden;
}
.wrap__hero__toast {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 16rpx 20rpx 8rpx;
}
.wrap__hero__toast__emoji {
  font-size: 26rpx;
}
.wrap__hero__toast__text {
  font-size: 23rpx;
  color: #8C6D60;
  font-weight: 600;
}
.wrap__usercard {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0 10rpx 28rpx rgba(125, 83, 60, 0.06);
  transition: -webkit-transform 0.15s ease;
  transition: transform 0.15s ease;
  transition: transform 0.15s ease, -webkit-transform 0.15s ease;
}
.wrap__usercard:active {
  -webkit-transform: scale(0.98);
          transform: scale(0.98);
}
.wrap__usercard__left {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
}
.wrap__usercard__avatar {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 4rpx solid #FFF5E8;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(125, 83, 60, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}
.wrap__usercard__info {
  min-width: 0;
  margin-left: 18rpx;
  flex: 1;
}
.wrap__usercard__name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: #5A3F33;
}
.wrap__usercard__name text:first-child {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 260rpx;
}
.wrap__usercard__tag {
  font-size: 19rpx;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  background: #FFF0DB;
  color: #A36B28;
  font-weight: 600;
}
.wrap__usercard__sub {
  font-size: 21rpx;
  color: #9B8074;
  margin-top: 6rpx;
}
.wrap__usercard__btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 14rpx 26rpx;
  border-radius: 32rpx;
  background: #7D533C;
  color: #FFFDF9;
  font-size: 23rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(125, 83, 60, 0.22);
}
.wrap__usercard__mascot {
  flex-shrink: 0;
}
.wrap__tablecard {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding: 20rpx 26rpx;
  background: #FFF7EB;
  border: 2rpx solid #F7E4C4;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 18rpx rgba(220, 160, 80, 0.08);
}
.wrap__tablecard__left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.wrap__tablecard__badge {
  font-size: 38rpx;
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: #FFE8C2;
  display: flex;
  align-items: center;
  justify-content: center;
}
.wrap__tablecard__text {
  display: flex;
  flex-direction: column;
}
.wrap__tablecard__title {
  font-size: 27rpx;
  font-weight: 700;
  color: #6E4733;
}
.wrap__tablecard__number {
  font-size: 34rpx;
  color: #C25648;
  font-weight: 800;
}
.wrap__tablecard__desc {
  font-size: 21rpx;
  color: #9C7D70;
  margin-top: 4rpx;
}
.wrap__tablecard__action {
  padding: 8rpx 22rpx;
  border-radius: 22rpx;
  background: #FFFFFF;
  color: #8C5939;
  font-size: 22rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 10rpx rgba(125, 83, 60, 0.08);
}
.wrap__section {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 30rpx 6rpx 16rpx;
}
.wrap__section__title {
  font-size: 30rpx;
  font-weight: 800;
  color: #5A3F33;
  letter-spacing: 1rpx;
}
.wrap__section__subtitle {
  font-size: 19rpx;
  color: #AD968B;
  letter-spacing: 3rpx;
  font-weight: 600;
}
.wrap__menu {
  display: flex;
  gap: 22rpx;
}
.wrap__menu__card {
  position: relative;
  flex: 1;
  min-width: 0;
  padding: 26rpx 22rpx 20rpx;
  border-radius: 36rpx;
  box-shadow: 0 12rpx 30rpx rgba(125, 83, 60, 0.07);
  transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.wrap__menu__card__head, .wrap__menu__card__body, .wrap__menu__card__foot {
