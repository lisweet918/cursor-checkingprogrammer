.wrap {
  width: 100%;
  min-height: 100vh;
  background-color: #FAFAFA;
  position: relative;
}
.wrap__userinfo {
  background-color: white;
  border-radius: 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 90%;
  margin: -25rpx auto 0 auto;
  position: relative;
  z-index: 1;
  padding: 20rpx;
}
.wrap__userinfo__left {
  display: flex;
  align-items: center;
}
.wrap__userinfo__left__nickname {
  color: #333333;
  font-weight: bold;
  font-size: 24rpx;
  margin-left: 10rpx;
}
.wrap__userinfo__right {
  background-color: #0A3D28;
  color: white;
  border-radius: 50rpx;
  padding: 10rpx 30rpx;
  font-size: 22rpx;
}
.wrap__tablecard {
  width: 90%;
  margin: 24rpx auto 0;
  padding: 28rpx 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #103b2a 0%, #1f5d43 100%);
  box-shadow: 0 16rpx 40rpx rgba(10, 61, 40, 0.16);
  color: #ffffff;
}
.wrap__tablecard__label {
  font-size: 22rpx;
  opacity: 0.8;
}
.wrap__tablecard__value {
  font-size: 52rpx;
  font-weight: bold;
  margin: 10rpx 0 12rpx;
  letter-spacing: 2rpx;
}
.wrap__tablecard__desc {
  font-size: 24rpx;
  opacity: 0.92;
}
.wrap__menu {
  display: flex;
  align-items: center;
  width: 90%;
  margin: 30rpx auto 0 auto;
  background-color: white;
  border-radius: 18rpx;
  padding: 10rpx 0 30rpx 0;
}
.wrap__menu__box {
  width: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.wrap__menu__box__name {
  font-size: 38rpx;
  color: #333333;
  font-weight: bold;
}
.wrap__menu__box__desc {
  font-size: 24rpx;
  color: #909399;
}
.wrap__menu__group {
  border-left: 1px solid #f4f4f5;
  height: 100rpx;
}
.wrap__pointsmall {
  display: flex;
  background-color: white;
  border-radius: 18rpx;
  width: 90%;
  margin: 30rpx auto;
  align-items: flex-end;
  padding-right: 30rpx;
}
.wrap__pointsmall__mypoint {
  font-size: 32rpx;
  color: #333333;
  font-weight: bold;
  margin-bottom: 20rpx;
}
.wrap__pointsmall__pointdesc {
  font-size: 24rpx;
  color: #909399;
  margin-bottom: 25rpx;
}
.wrap__popup {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 99;
}
.wrap__popup__mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
}
.wrap__popup__panel {
  position: absolute;
  left: 50%;
  top: 50%;
  -webkit-transform: translate(-50%, -50%);
          transform: translate(-50%, -50%);
  width: 86%;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 42rpx 32rpx 34rpx;
  box-sizing: border-box;
}
.wrap__popup__title {
  text-align: center;
  font-size: 38rpx;
  font-weight: bold;
  color: #222222;
}
.wrap__popup__table {
  margin-top: 16rpx;
  text-align: center;
  font-size: 46rpx;
  font-weight: bold;
  color: #0A3D28;
}
.wrap__popup__subtitle {
  margin-top: 18rpx;
  text-align: center;
  font-size: 24rpx;
  color: #7f7f7f;
}
.wrap__popup__options {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  margin-top: 34rpx;
}
.wrap__popup__option {
  height: 84rpx;
  border-radius: 18rpx;
  background: #f5f6f8;
  color: #333333;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
}
.wrap__popup__option--active {
  background: rgba(10, 61, 40, 0.08);
  border-color: #0A3D28;
  color: #0A3D28;
  font-weight: bold;
}
.wrap__popup__actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}
.wrap__popup__button {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  background: #0A3D28;
  color: #ffffff;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.wrap__popup__button--ghost {
  background: #eef1ee;
  color: #0A3D28;
}
