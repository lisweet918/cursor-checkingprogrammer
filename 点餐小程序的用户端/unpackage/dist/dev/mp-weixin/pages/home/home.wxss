}
.wrap__popup__option--active {
  background: #FFF2DF;
  border-color: #F5B96B;
  color: #8C5318;
  font-weight: 800;
  box-shadow: 0 4rpx 12rpx rgba(245, 185, 107, 0.25);
}
.wrap__popup__actions {
  display: flex;
  gap: 18rpx;
  margin-top: 32rpx;
}
.wrap__popup__button {
