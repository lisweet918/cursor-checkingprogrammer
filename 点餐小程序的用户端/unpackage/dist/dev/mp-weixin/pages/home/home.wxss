.wrap__popup {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100vw;
  height: 100vh;
  z-index: 99999;
}
.wrap__popup__mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: rgba(45, 25, 15, 0.55);
}
.wrap__popup__panel {
  position: absolute;
  left: 50%;
  top: 50%;
  -webkit-transform: translate(-50%, -50%);
          transform: translate(-50%, -50%);
  width: 86%;
  max-width: 620rpx;
  background: #FCFAF6;
  border: 4rpx solid #FFFFFF;
  border-radius: 44rpx;
  box-shadow: 0 24rpx 60rpx rgba(80, 50, 30, 0.25);
  padding: 40rpx 32rpx 36rpx;
