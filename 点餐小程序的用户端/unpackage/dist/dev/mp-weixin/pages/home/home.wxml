<view class="wrap"><block wx:if="{{$root.g0}}"><view><u-swiper vue-id="1da55560-1" list="{{swiperList}}" height="600" border-radius="0" mode="none" bind:__l="__l"></u-swiper></view></block><view data-event-opts="{{[['tap',[['handleLogin',['$event']]]]]}}" class="wrap__userinfo" bindtap="__e"><view class="wrap__userinfo__left"><view><u-image vue-id="1da55560-2" src="{{displayAvatar}}" width="60" height="60" border-radius="50%" lazy-load="{{true}}" bind:__l="__l"></u-image></view><view class="wrap__userinfo__left__nickname">{{''+(userinfo.nickname||'尊敬的用户')+''}}</view></view><block wx:if="{{!userinfo.nickname}}"><view class="wrap__userinfo__right"><view>注册/登录</view></view></block></view><block wx:if="{{tableInfo.tableNumber}}"><view class="wrap__tablecard"><view class="wrap__tablecard__label">当前桌号</view><view class="wrap__tablecard__value">{{tableInfo.tableNumber}}</view><view class="wrap__tablecard__desc">{{''+(tableInfo.diningCount?tableInfo.diningCount+'人就餐':'请选择就餐人数后开始点餐')+''}}</view></view></block><view class="wrap__menu"><view data-event-opts="{{[['tap',[['handlePointSingle',['takein']]]]]}}" class="wrap__menu__box" bindtap="__e"><view><u-image vue-id="1da55560-3" src="/static/img/home/icon-1.jpg" width="180" height="180" lazy-load="{{true}}" bind:__l="__l"></u-image></view><view class="wrap__menu__box__name">门店堂食</view><view class="wrap__menu__box__desc">提前点免排队</view></view><view class="wrap__menu__group"></view><view data-event-opts="{{[['tap',[['handlePointSingle',['takeout']]]]]}}" class="wrap__menu__box" bindtap="__e"><view><u-image vue-id="1da55560-4" src="/static/img/home/icon-2.jpg" width="180" height="180" lazy-load="{{true}}" bind:__l="__l"></u-image></view><view class="wrap__menu__box__name">外卖配送</view><view class="wrap__menu__box__desc">外卖及时送达</view></view></view><block wx:if="{{tablePopupVisible}}"><view class="wrap__popup"><view data-event-opts="{{[['tap',[['closeTablePopup',['$event']]]]]}}" class="wrap__popup__mask" bindtap="__e"></view><view class="wrap__popup__panel"><view class="wrap__popup__title">欢迎入座</view><view class="wrap__popup__table">{{"当前桌号 "+currentTableNumber}}</view><view class="wrap__popup__subtitle">请选择本桌就餐人数</view><view class="wrap__popup__options"><block wx:for="{{diningCountOptions}}" wx:for-item="item" wx:for-index="__i0__" wx:key="*this"><view data-event-opts="{{[['tap',[['selectDiningCount',['$0'],[[['diningCountOptions','',__i0__]]]]]]]}}" class="{{['wrap__popup__option',(selectedDiningCount===item)?'wrap__popup__option--active':'']}}" bindtap="__e">{{''+item+'人'}}</view></block></view><view class="wrap__popup__actions"><view data-event-opts="{{[['tap',[['closeTablePopup',['$event']]]]]}}" class="wrap__popup__button wrap__popup__button--ghost" bindtap="__e">稍后选择</view><view data-event-opts="{{[['tap',[['confirmTableInfo',['$event']]]]]}}" class="wrap__popup__button" bindtap="__e">开始点餐</view></view></view></view></block></view>