.container {
  background-color: #ffffff;
  display: flex;
  flex-direction: column;
}
.header {
  z-index: 10;
}
.header .center {
  padding: 10rpx 40rpx;
  display: flex;
  flex-direction: column;
}
.header .center .store {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.header .center .store .title {
  flex: 1;
  display: flex;
  overflow: hidden;
  flex-direction: column;
}
.header .center .store .title .address {
  font-size: 32rpx;
  color: #343434;
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.header .center .store .title .business {
  font-size: 24rpx;
  color: #909399;
}
.header .center .store .title .table-tag {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  margin-top: 8rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background-color: rgba(10, 61, 40, 0.08);
  color: #0A3D28;
  font-size: 22rpx;
  font-weight: bold;
}
.header .center .store .buttons {
  display: flex;
  align-items: stretch;
  background-color: #f6f6f6;
  border-radius: 50rem !important;
  padding: 4rpx;
  border: 2rpx solid #eaeaea;
}
.header .center .store .buttons .button {
  height: 100%;
  width: 50%;
  border-radius: 50rem !important;
  border: 0 !important;
  font-size: 24rpx !important;
  line-height: 2.4 !important;
}
.header .center .store .buttons .button.active {
  background-color: #0A3D28;
  color: #ffffff !important;
  transition: all 0.3s;
}
.main {
  flex: 1;
  display: flex;
  overflow: hidden;
}
.menu-bar {
  width: 170rpx;
  background-color: #f6f6f6;
}
.menu-bar .wrapper {
  height: auto;
}
.menu-bar .wrapper .menu-item {
  padding: 30rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 26rpx;
  color: #999;
  overflow: hidden;
}
.menu-bar .wrapper .menu-item:nth-last-child(1) {
  margin-bottom: 100rpx;
}
.menu-bar .wrapper .menu-item .image {
  width: 50rpx;
  height: 50rpx;
}
.menu-bar .wrapper .menu-item .title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.menu-bar .wrapper .menu-item.active {
  background-color: #ffffff;
  color: #343434;
  font-weight: 500 !important;
  border-left: 7rpx solid #0A3D28;
}
.product-section {
  flex: 1;
}
.product-section .wrapper {
  padding: 0 20rpx;
  padding-bottom: 130rpx;
}
.product-section .products-list .category-name {
  padding: 30rpx 0;
  font-size: 26rpx;
  color: #999;
}
.product-section .products-list .products {
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
}
.product-section .products-list .product {
  display: flex;
  align-items: flex-start;
  margin-bottom: 40rpx;
  justify-content: space-between;
}
.product-section .products-list .product .image {
  width: 180rpx;
  height: 135rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  border-radius: 8rpx;
}
.product-section .products-list .product .content {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.product-section .products-list .product .content .name {
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 8rpx;
  font-weight: bold;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.product-section .products-list .product .content .sold {
  color: #909399;
  font-size: 20rpx;
  margin-bottom: 9rpx;
}
.product-section .products-list .product .content .labels {
  display: flex;
  font-size: 20rpx;
  overflow: hidden;
  flex-wrap: wrap;
}
.product-section .products-list .product .content .labels .label {
  max-width: 40%;
  padding: 6rpx 10rpx;
  margin-right: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.product-section .products-list .product .content .price {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 20rpx;
}
.product-section .products-list .product .content .price .prices {
  display: flex;
  align-items: baseline;
  color: #FF362D;
  font-weight: bold;
}
.product-section .products-list .product .content .price .prices text:nth-child(1) {
  font-size: 20rpx;
  margin-right: 5rpx;
}
.product-section .products-list .product .content .price .prices text:nth-child(2) {
  font-size: 30rpx;
}
.cart-actions {
  display: flex;
  align-items: center;
}
.cart-actions .add-btn,
.cart-actions .minus-btn {
  width: 50rpx;
  height: 50rpx;
}
.cart-actions .number {
  width: 50rpx;
  height: 50rpx;
  margin: 0 20rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 36rpx;
}
.empty-menu {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}
.empty-menu__icon {
  width: 140rpx;
  height: 140rpx;
  opacity: 0.35;
  margin-bottom: 30rpx;
}
.empty-menu__text {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}
.empty-menu__switch {
  padding: 16rpx 60rpx;
  background-color: #0A3D28;
  color: #ffffff;
  border-radius: 40rpx;
  font-size: 26rpx;
}
.cart-companion {
  margin: 0 24rpx 18rpx;
  pointer-events: none;
}
.menu-companion {
  margin: 30rpx 24rpx;
}
.container {
  background: #FCF9F2;
  color: #5A3F33;
}
.header {
  background: linear-gradient(180deg, #FFFFFF 0%, #FAF5ED 100%);
  border-bottom: 2rpx solid #F5ECE0;
}
.header .center {
  padding-top: 18rpx;
  padding-bottom: 18rpx;
}
.header .center .store .title .address {
  color: #5A3F33;
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}
.header .center .store .title .business {
  margin-top: 6rpx;
  color: #9C8276;
  font-size: 21rpx;
}
.header .center .store .title .companion-tip {
  align-self: flex-start;
  max-width: 100%;
  margin-top: 10rpx;
  padding: 6rpx 16rpx;
  border-radius: 18rpx;
  background: #FFF2DF;
  color: #9C661D;
  font-weight: 600;
  font-size: 21rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}
.header .center .store .title .table-tag {
  background: #FFF7EB;
  border: 1rpx solid #F7E4C4;
  color: #6E4733;
  font-weight: 700;
  border-radius: 16rpx;
}
.header .center .store .buttons {
  background: #FFFFFF;
  border-color: #F0E2D4;
  border-radius: 36rpx;
  box-shadow: 0 6rpx 16rpx rgba(125, 83, 60, 0.08);
}
.header .center .store .buttons .button {
  color: #7D533C !important;
  font-weight: 600;
}
.header .center .store .buttons .button.active {
  background: #7D533C;
  color: #FFFDF9 !important;
  border-radius: 30rpx;
  font-weight: 700;
}
.main {
  background: #FCF9F2;
}
.menu-bar {
  background: #F8F3EC;
}
.menu-bar .wrapper .menu-item {
  color: #9E8579;
  font-weight: 500;
}
.menu-bar .wrapper .menu-item .image {
  border-radius: 14rpx;
}
.menu-bar .wrapper .menu-item.active {
  background: #FCF9F2;
  border-left-color: #F5A623;
  color: #5A3F33;
  font-weight: 800 !important;
}
.product-section {
  background: #FCF9F2;
}
.product-section .ads1 {
  margin: 16rpx 0 10rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(125, 83, 60, 0.06);
}
.product-section .ads1 .banner-image {
  width: 100%;
  display: block;
}
.product-section .products-list .category-name {
  display: flex;
  align-items: center;
  color: #5A3F33;
  font-size: 28rpx;
  font-weight: 800;
}
.product-section .products-list .category-name::before {
  content: "";
  width: 8rpx;
  height: 28rpx;
  margin-right: 12rpx;
  border-radius: 8rpx;
  background: #F5A623;
}
.product-section .products-list .product {
  box-sizing: border-box;
  margin-bottom: 20rpx;
  padding: 20rpx;
  border: 2rpx solid #FAF6F0;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(125, 83, 60, 0.05);
}
.product-section .products-list .product .image {
  border-radius: 20rpx;
}
.product-section .products-list .product .content .name {
  color: #5A3F33;
  font-weight: 700;
}
.product-section .products-list .product .content .sold {
  color: #A89185;
}
.product-section .products-list .product .content .labels .label {
  border-radius: 12rpx;
  font-weight: 600;
}
.product-section .products-list .product .content .price .prices {
  color: #C25648;
  font-weight: 800;
}
.empty-menu {
  background: #FFFFFF;
  border-radius: 36rpx;
  margin: 30rpx;
  padding: 60rpx 40rpx;
}
.empty-menu__text {
  color: #9E8579;
}
.empty-menu__switch {
  background: #7D533C;
  box-shadow: 0 8rpx 20rpx rgba(125, 83, 60, 0.22);
  border-radius: 36rpx;
  font-weight: 700;
  color: #FFFDF9;
}
.glass-menu {
  background-color: #eef5f2;
  background-image: radial-gradient(ellipse at 0% 12%, rgba(168, 223, 211, 0.65), transparent 52%), radial-gradient(ellipse at 100% 34%, rgba(255, 212, 192, 0.64), transparent 54%), radial-gradient(ellipse at 12% 90%, rgba(216, 209, 244, 0.62), transparent 54%);
  background-size: 100% 100%;
  background-repeat: no-repeat;
  color: #59483f;
}
.glass-menu .header {
  background: rgba(255, 255, 255, 0.3);
  border-bottom-color: rgba(255, 255, 255, 0.7);
}
.glass-menu .header .center .store .buttons {
  background-color: rgba(250, 253, 251, 0.94);
  background-image: linear-gradient(135deg, rgba(255, 255, 255, 0.48), rgba(255, 255, 255, 0) 46%, rgba(234, 243, 255, 0.16));
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.82), inset 0 2rpx 0 rgba(255, 255, 255, 0.95), 0 12rpx 32rpx rgba(76, 101, 99, 0.09);
  border-color: rgba(255, 255, 255, 0.8);
}
@supports ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) or (-webkit-backdrop-filter: blur(1px)) {
.glass-menu .header .center .store .buttons {
    background-color: rgba(250, 253, 251, 0.72);
    -webkit-backdrop-filter: blur(12px) saturate(135%);
    backdrop-filter: blur(12px) saturate(135%);
}
}
@media (prefers-reduced-transparency: reduce) {
.glass-menu .header .center .store .buttons {
    background-color: #f9fcfa;
    background-image: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
}
}
.glass-menu .header .center .store .buttons .button.active {
  background: linear-gradient(155deg, #a47b62 0%, #80583f 52%, #704b36 100%);
  color: #fffdf9;
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.48), inset 0 0 0 1px rgba(255, 255, 255, 0.18), 0 8rpx 18rpx rgba(106, 74, 54, 0.2);
}
.glass-menu .header .center .store .title .companion-tip {
  background: rgba(255, 255, 255, 0.76);
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.9), 0 6rpx 18rpx rgba(76, 101, 99, 0.05);
  color: #7e6350;
}
.glass-menu .main, .glass-menu .product-section {
  background: transparent;
}
.glass-menu .menu-bar {
  background: rgba(242, 248, 245, 0.38);
}
.glass-menu .menu-bar .wrapper .menu-item {
  color: #81736a;
}
.glass-menu .menu-bar .wrapper .menu-item.active {
  background: rgba(255, 255, 255, 0.76);
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.9), 0 6rpx 18rpx rgba(76, 101, 99, 0.05);
  border-left-color: #b48b6c;
  color: #654c3d;
}
.glass-menu .product-section .products-list .category-name::before {
  background: #b48b6c;
}
.glass-menu .product-section .products-list .product {
  background: rgba(255, 255, 255, 0.76);
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.9), 0 6rpx 18rpx rgba(76, 101, 99, 0.05);
  border-color: rgba(255, 255, 255, 0.76);
}
.glass-menu .product-section .products-list .product .content .sold {
  color: #82756d;
}
.glass-menu .empty-menu {
  background: rgba(255, 255, 255, 0.76);
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.9), 0 6rpx 18rpx rgba(76, 101, 99, 0.05);
}
.glass-menu .empty-menu__switch {
  background: linear-gradient(155deg, #a47b62 0%, #80583f 52%, #704b36 100%);
  color: #fffdf9;
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.48), inset 0 0 0 1px rgba(255, 255, 255, 0.18), 0 8rpx 18rpx rgba(106, 74, 54, 0.2);
}
