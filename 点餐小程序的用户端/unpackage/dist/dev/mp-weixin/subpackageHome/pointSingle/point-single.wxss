.container {
  background-color: #ffffff;
  display: flex;
  flex-direction: column;
}
.header {
  z-index: 10;
}
.header .center {
  padding: 10rpx 40rpx;
  display: flex;
  flex-direction: column;
}
.header .center .store {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.header .center .store .title {
  flex: 1;
  display: flex;
  overflow: hidden;
  flex-direction: column;
}
.header .center .store .title .address {
  font-size: 32rpx;
  color: #343434;
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.header .center .store .title .business {
  font-size: 24rpx;
  color: #909399;
}
.header .center .store .title .table-tag {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  margin-top: 8rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background-color: rgba(10, 61, 40, 0.08);
  color: #0A3D28;
  font-size: 22rpx;
  font-weight: bold;
}
.header .center .store .buttons {
  display: flex;
  align-items: stretch;
  background-color: #f6f6f6;
  border-radius: 50rem !important;
  padding: 4rpx;
  border: 2rpx solid #eaeaea;
}
.header .center .store .buttons .button {
  height: 100%;
  width: 50%;
  border-radius: 50rem !important;
  border: 0 !important;
  font-size: 24rpx !important;
  line-height: 2.4 !important;
}
.header .center .store .buttons .button.active {
  background-color: #0A3D28;
  color: #ffffff !important;
  transition: all 0.3s;
}
.main {
  flex: 1;
  display: flex;
  overflow: hidden;
}
.menu-bar {
  width: 170rpx;
  background-color: #f6f6f6;
}
.menu-bar .wrapper {
  height: auto;
}
.menu-bar .wrapper .menu-item {
  padding: 30rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 26rpx;
  color: #999;
  overflow: hidden;
}
.menu-bar .wrapper .menu-item:nth-last-child(1) {
  margin-bottom: 100rpx;
}
.menu-bar .wrapper .menu-item .image {
  width: 50rpx;
  height: 50rpx;
}
.menu-bar .wrapper .menu-item .title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.menu-bar .wrapper .menu-item.active {
  background-color: #ffffff;
  color: #343434;
  font-weight: 500 !important;
  border-left: 7rpx solid #0A3D28;
}
.product-section {
  flex: 1;
}
.product-section .wrapper {
  padding: 0 20rpx;
  padding-bottom: 130rpx;
}
.product-section .products-list .category-name {
  padding: 30rpx 0;
  font-size: 26rpx;
  color: #999;
}
.product-section .products-list .products {
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
}
.product-section .products-list .product {
  display: flex;
  align-items: flex-start;
  margin-bottom: 40rpx;
  justify-content: space-between;
}
.product-section .products-list .product .image {
  width: 180rpx;
  height: 135rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  border-radius: 8rpx;
}
.product-section .products-list .product .content {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.product-section .products-list .product .content .name {
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 8rpx;
  font-weight: bold;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.product-section .products-list .product .content .sold {
  color: #909399;
  font-size: 20rpx;
  margin-bottom: 9rpx;
}
.product-section .products-list .product .content .labels {
  display: flex;
  font-size: 20rpx;
  overflow: hidden;
  flex-wrap: wrap;
}
.product-section .products-list .product .content .labels .label {
  max-width: 40%;
  padding: 6rpx 10rpx;
  margin-right: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.product-section .products-list .product .content .price {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 20rpx;
}
.product-section .products-list .product .content .price .prices {
  display: flex;
  align-items: baseline;
  color: #FF362D;
  font-weight: bold;
}
.product-section .products-list .product .content .price .prices text:nth-child(1) {
  font-size: 20rpx;
  margin-right: 5rpx;
}
.product-section .products-list .product .content .price .prices text:nth-child(2) {
  font-size: 30rpx;
}
.cart-actions {
  display: flex;
  align-items: center;
}
.cart-actions .add-btn,
.cart-actions .minus-btn {
  width: 50rpx;
  height: 50rpx;
}
.cart-actions .number {
  width: 50rpx;
  height: 50rpx;
  margin: 0 20rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 36rpx;
}
.empty-menu {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}
.empty-menu__icon {
  width: 140rpx;
  height: 140rpx;
  opacity: 0.35;
  margin-bottom: 30rpx;
}
.empty-menu__text {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}
.empty-menu__switch {
  padding: 16rpx 60rpx;
  background-color: #0A3D28;
  color: #ffffff;
  border-radius: 40rpx;
  font-size: 26rpx;
}
.container {
  background: #FFFDF7;
  color: #65483D;
}
.header {
  background: linear-gradient(180deg, #FFFDF7 0%, #EAF8FA 100%);
  border-bottom: 1rpx solid rgba(101, 72, 61, 0.08);
}
.header .center {
  padding-top: 18rpx;
  padding-bottom: 18rpx;
}
.header .center .store .title .address {
  color: #65483D;
  font-size: 34rpx;
  letter-spacing: 1rpx;
}
.header .center .store .title .business {
  margin-top: 5rpx;
  color: #9A7D70;
}
.header .center .store .title .companion-tip {
  align-self: flex-start;
  max-width: 100%;
  margin-top: 10rpx;
  padding: 5rpx 14rpx;
  border-radius: 18rpx;
  background: #F9DFDA;
  color: #815B49;
  font-size: 20rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}
.header .center .store .title .table-tag {
  background: #FFFFFF;
  border: 1rpx solid #CDECF0;
  color: #65483D;
}
.header .center .store .buttons {
  background: rgba(255, 255, 255, 0.85);
  border-color: #EADBD3;
  box-shadow: 0 4rpx 14rpx rgba(101, 72, 61, 0.08);
}
.header .center .store .buttons .button {
  color: #815B49 !important;
}
.header .center .store .buttons .button.active {
  background: #815B49;
  color: #FFFFFF !important;
}
.main {
  background: #FFFDF7;
}
.menu-bar {
  background: #F8EFEA;
}
.menu-bar .wrapper .menu-item {
  color: #9A7D70;
}
.menu-bar .wrapper .menu-item .image {
  border-radius: 14rpx;
}
.menu-bar .wrapper .menu-item.active {
  background: #FFFDF7;
  border-left-color: #ECAEA4;
  color: #65483D;
  font-weight: 600 !important;
}
.product-section {
  background: #FFFDF7;
}
.product-section .ads1 {
  margin: 16rpx 0 10rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(101, 72, 61, 0.08);
}
.product-section .products-list .category-name {
  display: flex;
  align-items: center;
  color: #65483D;
  font-size: 28rpx;
  font-weight: 700;
}
.product-section .products-list .category-name::before {
  content: "";
  width: 8rpx;
  height: 28rpx;
  margin-right: 12rpx;
  border-radius: 8rpx;
  background: #F2B7AD;
}
.product-section .products-list .product {
  box-sizing: border-box;
  margin-bottom: 20rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(101, 72, 61, 0.08);
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 22rpx rgba(101, 72, 61, 0.06);
}
.product-section .products-list .product .image {
  border-radius: 18rpx;
}
.product-section .products-list .product .content .name {
  color: #65483D;
}
.product-section .products-list .product .content .sold {
  color: #A88E82;
}
.product-section .products-list .product .content .labels .label {
  border-radius: 10rpx;
}
.product-section .products-list .product .content .price .prices {
  color: #C9655B;
}
.empty-menu {
  background: #FFFDF7;
}
.empty-menu__text {
  color: #9A7D70;
}
.empty-menu__switch {
  background: #815B49;
  box-shadow: 0 8rpx 20rpx rgba(129, 91, 73, 0.18);
}
