<view class="container"><block wx:if="{{orderType!='takeshop'}}"><view><view class="font-size-medium">快捷标签</view><view class="remarks"><block wx:for="{{remarks}}" wx:for-item="remark" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['choose',[index]]]]]}}" class="{{['remark',(remark.active)?'active':'']}}" bindtap="__e">{{''+remark.label+''}}</view></block></view></view></block><view class="textarea-box"><textarea class="textarea" placeholder-class="placeholder" maxlength="{{50}}" data-event-opts="{{[['input',[['__set_model',['','remark','$event',[]]],['handleTextareaInput',['$event']]]]]}}" value="{{remark}}" bindinput="__e"></textarea><view class="tips">{{$root.g0+" / 50"}}</view></view><button data-event-opts="{{[['tap',[['submit',['$event']]]]]}}" class="w-100 font-size-extra-lg border-radius-lg" style="margin-top:50rpx;" bindtap="__e">提交</button></view>