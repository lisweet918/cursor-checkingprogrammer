{
	"bsonType": "object",
	"required": ["image"],
	"permission": {
		"read": true,
		"create": "auth.uid != null",
		"update": "auth.uid != null",
		"delete": "auth.uid != null"
	},
	"properties": {
		"_id": {
			"description": "ID，系统自动生成"
		},
		"image": {
			"bsonType": "string",
			"description": "点餐页轮播图URL",
			"title": "图片地址"
		},
		"sort": {
			"bsonType": "int",
			"description": "排序，数值越小越靠前",
			"title": "排序"
		},
		"is_show": {
			"bsonType": "bool",
			"description": "是否显示",
			"title": "显示状态"
		},
		"createTime": {
			"bsonType": "timestamp",
			"description": "创建时间"
		}
	}
}
