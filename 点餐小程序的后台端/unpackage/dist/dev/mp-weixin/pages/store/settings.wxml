<view class="uni-container data-v-3b6f3c6c"><view class="uni-header data-v-3b6f3c6c"><view class="uni-group data-v-3b6f3c6c"><view class="uni-title data-v-3b6f3c6c">店铺设置</view><view class="uni-sub-title data-v-3b6f3c6c">修改小程序中显示的店铺名称</view></view></view><view class="form-container data-v-3b6f3c6c"><view class="field-row data-v-3b6f3c6c"><text class="field-label data-v-3b6f3c6c">店铺名称</text><input class="field-input data-v-3b6f3c6c" type="text" placeholder="请输入店铺名称" data-event-opts="{{[['input',[['__set_model',['$0','store_name','$event',[]],['formData']]]]]}}" value="{{formData.store_name}}" bindinput="__e"/></view><view class="field-row data-v-3b6f3c6c"><text class="field-label data-v-3b6f3c6c">营业时间</text><input class="field-input data-v-3b6f3c6c" type="text" placeholder="例：早5:00 - 晚18:00" data-event-opts="{{[['input',[['__set_model',['$0','business_hours','$event',[]],['formData']]]]]}}" value="{{formData.business_hours}}" bindinput="__e"/></view><view class="field-row data-v-3b6f3c6c"><text class="field-label data-v-3b6f3c6c">微信接单通知</text><input class="field-input data-v-3b6f3c6c" type="text" placeholder="请输入PushPlus的Token，为空则不通知" data-event-opts="{{[['input',[['__set_model',['$0','pushplus_token','$event',[]],['formData']]]]]}}" value="{{formData.pushplus_token}}" bindinput="__e"/></view><view class="section-divider data-v-3b6f3c6c"><text class="section-title data-v-3b6f3c6c">外卖费用设置</text><text class="section-desc data-v-3b6f3c6c">仅影响外卖订单，全部留空或填 0 则不收取相应费用</text></view><view class="field-row data-v-3b6f3c6c"><text class="field-label data-v-3b6f3c6c">打包费(元)</text><input class="field-input data-v-3b6f3c6c" type="digit" placeholder="每单打包费，例：1" data-event-opts="{{[['input',[['__set_model',['$0','packing_fee','$event',[]],['formData']]]]]}}" value="{{formData.packing_fee}}" bindinput="__e"/></view><view class="field-row data-v-3b6f3c6c"><text class="field-label data-v-3b6f3c6c">配送费(元)</text><input class="field-input data-v-3b6f3c6c" type="digit" placeholder="基础配送费，例：3" data-event-opts="{{[['input',[['__set_model',['$0','delivery_fee','$event',[]],['formData']]]]]}}" value="{{formData.delivery_fee}}" bindinput="__e"/></view><view class="field-row data-v-3b6f3c6c"><text class="field-label data-v-3b6f3c6c">免配送费门槛(元)</text><input class="field-input data-v-3b6f3c6c" type="digit" placeholder="满此金额免配送费，0 为不免" data-event-opts="{{[['input',[['__set_model',['$0','free_delivery_threshold','$event',[]],['formData']]]]]}}" value="{{formData.free_delivery_threshold}}" bindinput="__e"/></view><view class="field-row data-v-3b6f3c6c"><text class="field-label data-v-3b6f3c6c">起送金额(元)</text><input class="field-input data-v-3b6f3c6c" type="digit" placeholder="外卖起送门槛，0 为不限制" data-event-opts="{{[['input',[['__set_model',['$0','min_order_amount','$event',[]],['formData']]]]]}}" value="{{formData.min_order_amount}}" bindinput="__e"/></view><view class="field-row actions data-v-3b6f3c6c"><button class="uni-button data-v-3b6f3c6c" type="primary" loading="{{loading}}" data-event-opts="{{[['tap',[['submit',['$event']]]]]}}" bindtap="__e">保存修改</button></view></view></view>