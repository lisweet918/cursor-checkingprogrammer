<view class="uni-container data-v-8d1d02fa"><view class="uni-header data-v-8d1d02fa"><view class="uni-group data-v-8d1d02fa"><view class="uni-title data-v-8d1d02fa">店铺设置</view><view class="uni-sub-title data-v-8d1d02fa">修改小程序中显示的店铺名称</view></view></view><view class="form-container data-v-8d1d02fa"><view class="field-row data-v-8d1d02fa"><text class="field-label data-v-8d1d02fa">店铺名称</text><input class="field-input data-v-8d1d02fa" type="text" placeholder="请输入店铺名称" data-event-opts="{{[['input',[['__set_model',['$0','store_name','$event',[]],['formData']]]]]}}" value="{{formData.store_name}}" bindinput="__e"/></view><view class="field-row data-v-8d1d02fa"><text class="field-label data-v-8d1d02fa">营业时间</text><input class="field-input data-v-8d1d02fa" type="text" placeholder="例：早5:00 - 晚18:00" data-event-opts="{{[['input',[['__set_model',['$0','business_hours','$event',[]],['formData']]]]]}}" value="{{formData.business_hours}}" bindinput="__e"/></view><view class="field-row data-v-8d1d02fa"><text class="field-label data-v-8d1d02fa">微信接单通知</text><input class="field-input data-v-8d1d02fa" type="text" placeholder="请输入PushPlus的Token，为空则不通知" data-event-opts="{{[['input',[['__set_model',['$0','pushplus_token','$event',[]],['formData']]]]]}}" value="{{formData.pushplus_token}}" bindinput="__e"/></view><view class="field-row actions data-v-8d1d02fa"><button class="uni-button data-v-8d1d02fa" type="primary" loading="{{loading}}" data-event-opts="{{[['tap',[['submit',['$event']]]]]}}" bindtap="__e">保存修改</button></view></view></view>