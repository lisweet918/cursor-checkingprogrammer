<view><view class="uni-header"><view class="uni-group"><view class="uni-title">分类管理</view><view class="uni-sub-title">管理菜品分类，分类创建后可在菜品中选择</view></view><view class="uni-group"><button class="uni-button" type="primary" size="mini" data-event-opts="{{[['tap',[['openForm']]]]}}" bindtap="__e">+ 新增分类</button></view></view><view class="uni-container"><unicloud-db generic:scoped-slots-default="list-unicloud-db-default" data-vue-generic="scoped" class="vue-ref" vue-id="2f14a8ee-1" collection="category" field="_id,name,sort,is_show,createTime" orderby="sort asc, createTime asc" getcount="{{true}}" loadtime="manual" data-ref="udb" data-event-opts="{{[['^load',[['onQueryLoad']]]]}}" bind:load="__e" bind:__l="__l" vue-slots="{{['default']}}"></unicloud-db></view><uni-popup class="vue-ref" vue-id="2f14a8ee-16" type="center" mask-click="{{false}}" data-ref="formPopup" bind:__l="__l" vue-slots="{{['default']}}"><view class="popup-box"><view class="popup-title">{{editId?'编辑分类':'新增分类'}}</view><view class="popup-body"><view class="field-row"><text class="field-label"><text style="color:red;">*</text> 分类名称</text><input class="field-input" placeholder="如：招牌必吃" data-event-opts="{{[['input',[['__set_model',['$0','name','$event',[]],['formData']]]]]}}" value="{{formData.name}}" bindinput="__e"/></view><view class="field-row"><text class="field-label">排序权重</text><input class="field-input" type="number" placeholder="数值越小越靠前，默认0" data-event-opts="{{[['input',[['__set_model',['$0','sort','$event',[]],['formData']]]]]}}" value="{{formData.sort}}" bindinput="__e"/></view><view class="field-row" style="align-items:center;"><text class="field-label">是否显示</text><switch checked="{{formData.is_show}}" data-event-opts="{{[['change',[['e0',['$event']]]]]}}" bindchange="__e"></switch><text style="margin-left:8px;color:#666;font-size:13px;">{{formData.is_show?'显示':'隐藏'}}</text></view></view><view class="popup-footer"><button data-event-opts="{{[['tap',[['closeForm',['$event']]]]]}}" class="uni-button" bindtap="__e">取消</button><button class="uni-button" type="primary" loading="{{submitting}}" data-event-opts="{{[['tap',[['submitForm',['$event']]]]]}}" bindtap="__e">{{editId?'保存':'新增'}}</button></view></view></uni-popup></view>