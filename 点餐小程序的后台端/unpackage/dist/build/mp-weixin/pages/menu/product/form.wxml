<view class="uni-container"><uni-forms class="vue-ref" vue-id="714a520a-1" model="{{formData}}" rules="{{rules}}" validateTrigger="bind" label-width="90px" data-ref="form" bind:__l="__l" vue-slots="{{['default']}}"><uni-forms-item vue-id="{{('714a520a-2')+','+('714a520a-1')}}" label="菜品图片" name="images" bind:__l="__l" vue-slots="{{['default']}}"><view class="img-section"><view class="img-list"><block wx:for="{{formData.images}}" wx:for-item="img" wx:for-index="idx" wx:key="idx"><view class="img-item"><image class="thumb" src="{{img.url}}" mode="aspectFill"></image><view data-event-opts="{{[['tap',[['removeImage',[idx]]]]]}}" class="img-delete" bindtap="__e">×</view></view></block><block wx:if="{{$root.g0<3}}"><view data-event-opts="{{[['tap',[['chooseImage',['$event']]]]]}}" class="img-add" bindtap="__e"><view class="img-add-icon">+</view><view class="img-add-text">上传图片</view></view></block></view><view class="img-tip">建议上传正方形图片，最多3张，第一张为主图</view></view></uni-forms-item><uni-forms-item vue-id="{{('714a520a-3')+','+('714a520a-1')}}" label="菜品名称" name="name" required="{{true}}" bind:__l="__l" vue-slots="{{['default']}}"><uni-easyinput bind:input="__e" vue-id="{{('714a520a-4')+','+('714a520a-3')}}" placeholder="请输入菜品名称" value="{{formData.name}}" data-event-opts="{{[['^input',[['__set_model',['$0','name','$event',[]],['formData']]]]]}}" bind:__l="__l"></uni-easyinput></uni-forms-item><uni-forms-item vue-id="{{('714a520a-5')+','+('714a520a-1')}}" label="价格(元)" name="price" required="{{true}}" bind:__l="__l" vue-slots="{{['default']}}"><uni-easyinput bind:input="__e" vue-id="{{('714a520a-6')+','+('714a520a-5')}}" type="number" placeholder="请输入价格，如 5.99" value="{{formData.price}}" data-event-opts="{{[['^input',[['__set_model',['$0','price','$event',[]],['formData']]]]]}}" bind:__l="__l"></uni-easyinput></uni-forms-item><uni-forms-item vue-id="{{('714a520a-7')+','+('714a520a-1')}}" label="所属分类" name="category_id" required="{{true}}" bind:__l="__l" vue-slots="{{['default']}}"><picker value="{{catIndex}}" range="{{categories}}" range-key="name" data-event-opts="{{[['change',[['onCatChange',['$event']]]]]}}" bindchange="__e"><view class="picker-view"><block wx:if="{{formData.category_id}}"><text>{{$root.m0}}</text></block><block wx:else><text style="color:#bbb;">请选择分类</text></block><text class="picker-arrow">›</text></view></picker></uni-forms-item><uni-forms-item vue-id="{{('714a520a-8')+','+('714a520a-1')}}" label="菜品描述" name="description" bind:__l="__l" vue-slots="{{['default']}}"><uni-easyinput bind:input="__e" vue-id="{{('714a520a-9')+','+('714a520a-8')}}" type="textarea" placeholder="请输入菜品描述（选填）" maxlength="{{200}}" value="{{formData.description}}" data-event-opts="{{[['^input',[['__set_model',['$0','description','$event',[]],['formData']]]]]}}" bind:__l="__l"></uni-easyinput></uni-forms-item><uni-forms-item vue-id="{{('714a520a-10')+','+('714a520a-1')}}" label="已售展示" name="sold" bind:__l="__l" vue-slots="{{['default']}}"><uni-easyinput bind:input="__e" vue-id="{{('714a520a-11')+','+('714a520a-10')}}" placeholder="如：600+（选填，展示在用户端）" value="{{formData.sold}}" data-event-opts="{{[['^input',[['__set_model',['$0','sold','$event',[]],['formData']]]]]}}" bind:__l="__l"></uni-easyinput></uni-forms-item><uni-forms-item vue-id="{{('714a520a-12')+','+('714a520a-1')}}" label="销售方式" bind:__l="__l" vue-slots="{{['default']}}"><view class="checkbox-group"><label class="checkbox-item"><checkbox checked="{{formData.is_pickup===1}}" data-event-opts="{{[['change',[['e0',['$event']]]]]}}" bindchange="__e"></checkbox><text>支持堂食自取</text></label><label class="checkbox-item"><checkbox checked="{{formData.is_takeout===1}}" data-event-opts="{{[['change',[['e1',['$event']]]]]}}" bindchange="__e"></checkbox><text>支持外卖配送</text></label></view></uni-forms-item><uni-forms-item vue-id="{{('714a520a-13')+','+('714a520a-1')}}" label="上架状态" bind:__l="__l" vue-slots="{{['default']}}"><switch checked="{{formData.is_show}}" data-event-opts="{{[['change',[['e2',['$event']]]]]}}" bindchange="__e"></switch><text style="margin-left:10px;color:#666;font-size:13px;">{{formData.is_show?'已上架':'已下架'}}</text></uni-forms-item><uni-forms-item vue-id="{{('714a520a-14')+','+('714a520a-1')}}" label="排序权重" name="sort" bind:__l="__l" vue-slots="{{['default']}}"><uni-easyinput bind:input="__e" vue-id="{{('714a520a-15')+','+('714a520a-14')}}" type="number" placeholder="数值越小越靠前（选填）" value="{{formData.sort}}" data-event-opts="{{[['^input',[['__set_model',['$0','sort','$event',[]],['formData']]]]]}}" bind:__l="__l"></uni-easyinput></uni-forms-item><view class="uni-button-group"><button class="uni-button" style="width:120px;" type="primary" loading="{{submitting}}" data-event-opts="{{[['tap',[['submit',['$event']]]]]}}" bindtap="__e">{{''+(isEdit?'保存修改':'新增菜品')+''}}</button><navigator style="margin-left:15px;" open-type="navigateBack"><button class="uni-button" style="width:100px;">返回</button></navigator></view></uni-forms></view>